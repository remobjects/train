/*
  Run this with a previously installed Train:
    Train build.train

    Set docsgen to the path of the docsgen executable to build documentation too.
*/

ebuild.runEBuild("Train.sln", "--configuration:Release --no-cache");

var dg = env["docsgen"];

if (dg) {
  log.info("Generating documentation");
  shell.exec(dg, "build docs --overrideoption=output:../Documentation");
} else {
  log.warning("docsgen env var not set to the docsgen executable, cannot generate documentation");
}
